# Flask Configuration
FLASK_APP=app.main:create_app
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/credit_rating_db

# Box MCP Server Configuration
# Use either BOX_MCP_SERVER_PATH (for stdio) or BOX_MCP_SERVER_URL (for SSE/HTTP)
BOX_MCP_SERVER_PATH=/path/to/box-mcp-server
BOX_MCP_SERVER_URL=http://localhost:8005/sse
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret
BOX_ENTERPRISE_ID=your-box-enterprise-id
BOX_METHODOLOGY_FOLDER_ID=your-methodology-folder-id
BOX_RATINGS_FOLDER_ID=your-ratings-folder-id

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# Financial Data Provider Configuration
FINANCIAL_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Application Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2
REQUEST_TIMEOUT=30
LLM_TIMEOUT=60
DATA_AGE_THRESHOLD_MONTHS=12
