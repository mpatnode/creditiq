# Dockerfile for Box MCP Server (Python implementation)
FROM python:3.11-slim

WORKDIR /mcp

# Install git and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Add uv to PATH
ENV PATH="/root/.local/bin:${PATH}"

# Clone the Box MCP server repository
RUN git clone https://github.com/box-community/mcp-server-box.git /mcp/server

WORKDIR /mcp/server

RUN uv add box-sdk-gen[jwt]
# Install dependencies using uv
RUN uv sync

# Expose port for HTTP/SSE transport
EXPOSE 8005

# Set the Box config path
ENV BOX_CONFIG_PATH=/mcp/server/.box_config.json

# Run the MCP server with HTTP/SSE transport
# Bind to 0.0.0.0 to be accessible from other containers
CMD ["uv", "run", "src/mcp_server_box.py", "--transport", "sse", "--host", "0.0.0.0", "--port", "8005", "--box-auth-type", "jwt", "--mcp-auth-type", "none"]
